      {
        "comment": "",
        "key": "Using the app",
        "location": {
          "startingColumn": 54,
          "startingLine": 156
        }
      },
      {
        "comment": "",
        "key": "The app is for students, parents and staff of %@. By signing in you accept these terms.",
        "location": {
          "startingColumn": 96,
          "startingLine": 156
        }
      },
      {
        "comment": "",
        "key": "Your account",
        "location": {
          "startingColumn": 54,
          "startingLine": 157
        }
      },
      {
        "comment": "",
        "key": "Keep your password and OTPs private. You are responsible for activity on your account and should report misuse to the college office.",
        "location": {
          "startingColumn": 95,
          "startingLine": 157
        }
      },
      {
        "comment": "",
        "key": "Respectful communication",
        "location": {
          "startingColumn": 54,
          "startingLine": 158
        }
      },
      {
        "comment": "",
        "key": "Messages, voice notes and concerns must be respectful and relate to college matters. Abusive content may be removed.",
        "location": {
          "startingColumn": 107,
          "startingLine": 158
        }
      },
      {
        "comment": "",
        "key": "Fees & payments",
        "location": {
          "startingColumn": 54,
          "startingLine": 159
        }
      },
      {
        "comment": "",
        "key": "Fee amounts and due dates are set by the college. Payment proofs are verified by the accounts office before they are marked paid. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 98,
          "startingLine": 159
        }
      },
      {
        "comment": "",
        "key": "Accuracy of information",
        "location": {
          "startingColumn": 54,
          "startingLine": 160
        }
      },
      {
        "comment": "",
        "key": "Attendance, marks and notices are published by the college. Raise a concern in the app if something looks wrong.",
        "location": {
          "startingColumn": 106,
          "startingLine": 160
        }
      },
      {
        "comment": "",
        "key": "Changes & contact",
        "location": {
          "startingColumn": 54,
          "startingLine": 161
        }
      },
      {
        "comment": "",
        "key": "We may update these terms and will notify you in the app. Questions: [SUPPORT EMAIL]. [REVIEW WITH LEGAL]",
