          "startingLine": 28
        }
      },
      {
        "comment": "",
        "key": "[DESCRIBE WHERE DATA IS STORED, ENCRYPTION AND RETENTION PERIOD]",
        "location": {
          "startingColumn": 101,
          "startingLine": 28
        }
      },
      {
        "comment": "",
        "key": "Your choices & rights",
        "location": {
          "startingColumn": 54,
          "startingLine": 29
        }
      },
      {
        "comment": "",
        "key": "You can update your profile, turn off notifications in Settings, and request a copy or correction of your data from the college office. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 104,
          "startingLine": 29
        }
      },
      {
        "comment": "",
        "key": "Changes to this policy",
        "location": {
          "startingColumn": 54,
          "startingLine": 30
        }
      },
      {
        "comment": "",
        "key": "We will notify you in the app before any important change takes effect. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 105,
          "startingLine": 30
        }
      },
