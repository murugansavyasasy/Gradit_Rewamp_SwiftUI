      {
        "comment": "",
        "key": "Information we collect",
        "location": {
          "startingColumn": 54,
          "startingLine": 25
        }
      },
      {
        "comment": "",
        "key": "Student and parent names, contact numbers, email, academic records (attendance, marks, homework), fee and payment details, and bus location while a trip is live. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 105,
          "startingLine": 25
        }
      },
      {
        "comment": "",
        "key": "How we use it",
        "location": {
          "startingColumn": 54,
          "startingLine": 26
        }
      },
      {
        "comment": "",
        "key": "To show academic progress, send notices and reminders, process fee payments and help families reach faculty. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 96,
          "startingLine": 26
        }
      },
      {
        "comment": "",
        "key": "Who can see your data",
        "location": {
          "startingColumn": 54,
          "startingLine": 27
        }
      },
      {
        "comment": "",
        "key": "Only you, linked parents or guardians, and authorised college staff. [REVIEW WITH LEGAL]",
        "location": {
          "startingColumn": 104,
          "startingLine": 27
        }
      },
      {
        "comment": "",
        "key": "Storage & security",
        "location": {
